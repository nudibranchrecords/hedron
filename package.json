{
  "name": "root",
  "private": true,
  "scripts": {
    "dev": "node -e \"process.platform === 'win32' ? require('child_process').execSync('pnpm run dev:win', {stdio: 'inherit'}) : require('child_process').execSync('pnpm run dev:mac', {stdio: 'inherit'})\"",
    "dev:win": "cd packages/desktop && pnpm dev",
    "dev:mac": "lerna run dev --parallel --ignore @hedron/example-project --ignore @hedron/midi-test-app --ignore @hedron/clock-test-app",
    "build": "lerna run build",
    "build:example": "node build-example-project.js",
    "typecheck": "lerna run typecheck",
    "lint": "lerna run lint",
    "format": "prettier . --write",
    "dist": "pnpm build:example && lerna run lint,typecheck,build,dist --sort",
    "version": "pnpm install && git stage pnpm-lock.yaml"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.17.0",
    "@tsconfig/recommended": "^1.0.8",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^0.8.0",
    "globals": "^15.14.0",
    "lerna": "^8.2.3",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.6",
    "typescript": "^5.6.2",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.3",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "packageManager": "pnpm@9.0.0"
}
