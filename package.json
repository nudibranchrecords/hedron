{
  "name": "root",
  "private": true,
  "scripts": {
    "dev": "lerna run dev --scope @hedron/desktop",
    "dev:clock": "lerna run dev --parallel --scope @hedron/clock --scope @hedron/clock-test-app",
    "storybook": "lerna run storybook --scope @hedron/ui-core",
    "build:engine": "lerna run build --scope @hedron/engine",
    "build": "lerna run build",
    "build:example": "node build-example-project.js",
    "typecheck": "lerna run typecheck",
    "lint": "lerna run lint",
    "format": "prettier . --write",
    "dist": "pnpm build:example && lerna run lint,typecheck,build,dist --sort",
    "version": "pnpm install && git stage pnpm-lock.yaml"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.17.0",
    "@tsconfig/recommended": "^1.0.8",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^0.8.0",
    "globals": "^15.14.0",
    "lerna": "^8.2.3",
    "prettier": "^3.4.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsup": "^8.3.6",
    "typescript": "^5.6.2",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.3",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "packageManager": "pnpm@9.0.0"
}
