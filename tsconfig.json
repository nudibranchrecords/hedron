{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "exclude": ["node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "noImplicitAny": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "allowSyntheticDefaultImports": true
  }
}
