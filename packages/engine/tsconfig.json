{
  "extends": ["../../tsconfig.json"],
  "include": ["src/**/*"],
  "compilerOptions": {
    "baseUrl": ".",
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@store/*": ["src/store/*"],
      "@utils/*": ["src/utils/*"],
      "@world/*": ["src/world/*"],
      "@plugins/*": ["src/plugins/*"],
      "@HedronEngine/*": ["src/HedronEngine/*"],
      "@globalVars": ["src/globalVars"],
      "@constants": ["src/constants"]
    }
  }
}
