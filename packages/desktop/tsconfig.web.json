{
  "extends": ["@electron-toolkit/tsconfig/tsconfig.web.json", "../../tsconfig.json"],
  "include": [
    "src/renderer/env.d.ts",
    "src/renderer/**/*",
    "src/renderer/**/*.tsx",
    "src/preload/*.d.ts",
    "src/shared/**/*",
    "src/stories/**/*"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/renderer/components/*"],
      "@css/*": ["src/renderer/css/*"],
      "@renderer/*": ["src/renderer/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
